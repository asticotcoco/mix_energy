
MODEL_REGISTRY=

# Address of the MLFLOW websit
MLFLOW_TRACKING_URI= # http://<adresse>:<port>
# MLFLOW tracking URI used by Airflow containers on the Docker network
MLFLOW_TRACKING_URI_AIRFLOW=http://mlflow:5000

# Airflow Docker runtime (compose file in airflow/)
AIRFLOW_IMAGE_NAME=
AIRFLOW_UID=

AIRFLOW_PROJ_DIR="."
AIRFLOW__API_AUTH__JWT_SECRET="airflow_jwt_secret"
AIRFLOW__API_AUTH__JWT_ISSUER="airflow"
AIRFLOW__API__BASE_URL="http://localhost:8502"

# GCP region
LOCATION=# GCP region
# BigQuery dataset location, e.g. EU
BIGQUERY_LOCATION=# BigQuery location
# GCP project ID
PROJECT_ID=# GCP project ID
DBT_TARGET=prod
DATASET_ID_PROD=# Base dataset ID for production; dbt appends _silver/_gold when needed
DATASET_ID_DEV=# Base dataset ID for development; dbt appends _silver/_gold when needed
# DATASET_ID="TEST_DBT"
BUCKET_NAME=# GCP bucket name
PREFIX=""
# GCP CREDENTIAL FILE PATH
GOOGLE_APPLICATION_CREDENTIALS=# GCP credential file path
GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=# GCP credential file path in container


SCHEMA_SAMPLE_ROWS=500

# GCP meteo API parameters
PAST_DAYS=# Number of past days to retrieve weather data for
FORCAST_DAYS=# Number of forecast days to retrieve weather data for

# Air quality API parameters
ATMO_USERNAME=# Air quality API username
ATMO_PASSWORD=# Air quality API password
ATMO_CODE_INSEE=# Air quality API INSEE code
ATMO_DATE_HISTORIQUE=# Air quality API historical date
ATMO_AASQA=# Air quality API AASQA code

# Base carbone Ademe
BASE_CARBONE_URL="https://www.data.gouv.fr/api/1/datasets/r/ac6a3044-459c-4520-b85a-7e1740f7cd1f"

# Artifact Registry name
REPOSITORY=# Artifact Registry name
# FastAPI Image name
IMAGE=# Image name
# FastAPI Application port
PORT= # port number exposed by the docker container
HOST_PORT= # port number on the host

# API base URL for Streamlit app
API_BASE_URL=
